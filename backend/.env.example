# ── MongoDB ───────────────────────────────────
# Local development:
MONGODB_URI=mongodb://localhost:27017/citepoint
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/citepoint

# ── Server ────────────────────────────────────
PORT=3000

# ── CORS ──────────────────────────────────────
# No extension origin is allowed unless it's listed here — set this to your
# real extension's chrome-extension://<id> / moz-extension://<id> origin(s).
# Single value:
# ALLOWED_ORIGIN=chrome-extension://your-extension-id-here
# OR comma-separated list (overrides ALLOWED_ORIGIN):
# ALLOWED_ORIGINS=chrome-extension://<id1>,moz-extension://<id2>
#
# For local dev / CI, where an unpacked/temporary extension gets a fresh,
# unpredictable origin on every run, use the '*' wildcard to accept any
# chrome-extension:// or moz-extension:// origin instead of a fixed list:
# ALLOWED_ORIGINS=*

# ── Logging ───────────────────────────────────
# Omit or set to 'development' for coloured dev logs.
# Set to 'production' for Apache-style combined logs (includes IPs, timestamps).
# NODE_ENV=production

# ── Access control ────────────────────────────
# Grants expert powers (category verification) without going through the
# application/review flow. Format: pipe-separated entries, each
# "username:topic1,topic2" — e.g. EXPERT_CONFIG=alice:History,Science|bob:Economics
# EXPERT_CONFIG=alice:History,Science

# Comma-separated usernames allowed to list pending expert applications and
# approve/reject them. Required — without this set, nobody can review applications.
# ADMIN_USERNAMES=admin_alice
