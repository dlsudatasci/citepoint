{
    "manifest_version": 3,
    "name": "YouTube Citation Extension",
    "version": "1.1",
    "description": "Add and manage citations for YouTube videos",
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    },
    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "http://localhost:3000/*",
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "citepoint@altdsi.internal",
            "strict_min_version": "121.0"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.youtube.com/*",
                "*://m.youtube.com/*"
            ],
            "js": [
                "lib/browser-polyfill.js",
                "utils/utils.js",
                "config/config.js",
                "content/api.js",
                "content/username.js",
                "content/citations.js",
                "content/voting.js",
                "content/forms.js",
                "content/recording.js",
                "content/report.js",
                "content/panel.js",
                "content/player.js",
                "content/content.js"
            ],
            "css": ["styles/extension.css"]
        }
    ],
    "background": {
        "service_worker": "background/background.js",
        "scripts": ["background/background.js"]
    },
    "web_accessible_resources": [{
        "resources": [
            "forms/youtube_extension_citation.html",
            "forms/youtube_extension_request.html",
            "styles/extension.css",
            "styles/tokens.css",
            "config/config.js",
            "popup/popup.js",
            "popup/popup.html",
            "dashboard/dashboard.html",
            "dashboard/dashboard.js",
            "dashboard/dashboard.css",
            "discussion/discussion.html",
            "discussion/discussion.js",
            "discussion/discussion.css",
            "content/username.js",
            "utils/utils.js"
        ],
        "matches": [
            "*://www.youtube.com/*",
            "*://m.youtube.com/*"
        ]
    }]
}